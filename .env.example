PORT=3000
NODE_ENV=production

MONGODB_URI=mongodb+srv://bacongcodaryl_db_user:AgriDrone@cluster0.v8d6mpt.mongodb.net/?appName=Cluster0

# Groq (recommended since you want free hosted LLM)

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.1-8b-instant


# If frontend and backend are served on same IP via Nginx, CORS can be simple:
CORS_ORIGINS=http://152.42.203.55

JWT_SECRET=your-super-secret-jwt-key-change-in-production
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

ENABLE_SEED_ENDPOINT=false
LOG_LEVEL=info
MAX_JSON_SIZE=2mb
REQUEST_TIMEOUT=30000
