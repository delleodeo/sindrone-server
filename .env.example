PORT=3000
NODE_ENV=production

MONGODB_URI=mongodb://localhost:27017/agridrone

# Groq (recommended since you want free hosted LLM)

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b

# Roboflow server-side inference (never expose this key through VITE_ variables)
ROBOFLOW_API_KEY=
ROBOFLOW_MODEL_ID=citrus-disease-detection-yoydc-ygw6l/1
ROBOFLOW_API_URL=https://serverless.roboflow.com/citrus-disease-detection-yoydc-ygw6l/1
ROBOFLOW_CONFIDENCE_THRESHOLD=0
ROBOFLOW_REQUEST_TIMEOUT_MS=20000
# 3.5 MiB keeps the base64 request below Roboflow's 5 MB hosted request limit.
ROBOFLOW_MAX_IMAGE_BYTES=3670016


# If frontend and backend are served on same IP via Nginx, CORS can be simple:
CORS_ORIGINS=http://152.42.203.55

JWT_SECRET=your-super-secret-jwt-key-change-in-production
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

ENABLE_SEED_ENDPOINT=false
LOG_LEVEL=info
MAX_JSON_SIZE=2mb
REQUEST_TIMEOUT=30000
